{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "/^training/[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "/^training/[^/]+$/"
      ],
      "matchPackageNames": [
        "numpy"
      ],
      "allowedVersions": "<2.5"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "/^training/[^/]+$/"
      ],
      "matchPackageNames": [
        "*"
      ],
      "groupName": "wake-tools",
      "groupSlug": "wake-tools"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ]
  }
}
