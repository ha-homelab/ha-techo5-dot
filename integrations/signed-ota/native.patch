+package config
+
+import (
+	"errors"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/HuskerMinion/techo5/echod/internal/lib/activitygate"
+)
+
+// Every accepted silence-policy path must preempt the exact guarded owner.
+// These stores and leases use no real device, media, configuration or network.
+func TestCheckedSilencePolicyPreemptsGuardedAnnouncement(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		change func(*Config)
+	}{
+		{"do_not_disturb", func(c *Config) { c.Home.DoNotDisturb = !c.Home.DoNotDisturb }},
+		{"quiet_hours", func(c *Config) { c.Speaker.QuietHours = "22:00-07:00" }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			st, err := Load(filepath.Join(t.TempDir(), "state.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			lease, reason := activitygate.Device.Reserve(time.Now().Add(time.Minute), func() string { return "" })
+			if lease == nil {
+				t.Fatal(reason)
+			}
+			defer lease.Release()
+			if err := st.UpdateChecked(func(c *Config) error { tc.change(c); return nil }); err != nil {
+				t.Fatal(err)
+			}
+			if lease.Valid() || lease.Reason() != "silence_policy_changed" {
+				t.Fatalf("policy change left announcement running: %q", lease.Reason())
+			}
+		})
+	}
+}
+
+func TestRejectedOrUnrelatedCheckedWriteKeepsGuardedAnnouncement(t *testing.T) {
+	st, err := Load(filepath.Join(t.TempDir(), "state.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := st.Get().Home.DoNotDisturb
+	lease, reason := activitygate.Device.Reserve(time.Now().Add(time.Minute), func() string { return "" })
+	if lease == nil {
+		t.Fatal(reason)
+	}
+	defer lease.Release()
+	refused := errors.New("refused test change")
+	if err := st.UpdateChecked(func(c *Config) error {
+		c.Home.DoNotDisturb = !before
+		return refused
+	}); !errors.Is(err, refused) {
+		t.Fatal("rejected write did not preserve its error", err)
+	}
+	if !lease.Valid() || st.Get().Home.DoNotDisturb != before {
+		t.Fatal("rejected policy write cancelled the announcement or survived rollback")
+	}
+	if err := st.UpdateChecked(func(c *Config) error { c.Alarms.Skipped = []Skip{{ID: "test", At: time.Now()}}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	if !lease.Valid() {
+		t.Fatal("unrelated checked change cancelled the announcement")
+	}
+}
+
+func TestFailedCheckedPolicyWriteRestoresSettingsButCancelsAnnouncement(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	st, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before := st.Get().Home.DoNotDisturb
+	unblock := failWrites(t, path)
+	defer unblock()
+	lease, reason := activitygate.Device.Reserve(time.Now().Add(time.Minute), func() string { return "" })
+	if lease == nil {
+		t.Fatal(reason)
+	}
+	defer lease.Release()
+	if err := st.UpdateChecked(func(c *Config) error { c.Home.DoNotDisturb = !before; return nil }); err == nil {
+		t.Fatal("failed write reported success")
+	}
+	if st.Get().Home.DoNotDisturb != before {
+		t.Fatal("failed policy write survived rollback")
+	}
+	if lease.Valid() || lease.Reason() != "silence_policy_changed" {
+		t.Fatal("accepted silence request did not conservatively cancel the announcement")
+	}
+}
