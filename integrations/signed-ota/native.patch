diff --git a/echod/internal/update/myshka.go b/echod/internal/update/myshka.go
new file mode 100644
index 00000000..b0a1d2af
--- /dev/null
+++ b/echod/internal/update/myshka.go
@@ -0,0 +1,123 @@
+package update
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+)
+
+const MyshkaDistribution = "myshka-dot2"
+const myshkaRepository = "https://github.com/ha-homelab/ha-techo5-dot"
+const maxManifestLifetime = 366 * 24 * time.Hour
+
+var myshkaVersion = regexp.MustCompile(`^v[0-9]{1,9}\.[0-9]{1,9}\.[0-9]{1,9}(-beta\.[1-9][0-9]{0,8})?_myshka[1-9][0-9]{0,8}$`)
+var assetName = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]*$`)
+
+type releaseProof struct {
+	body, signature []byte
+	channel         Channel
+}
+
+// validMyshka binds the signed payload to this distribution, channel, lifetime,
+// architecture and immutable repository assets. Only these local A/B images are
+// supported; there is no arbitrary URL, unsigned or stock-channel escape hatch.
+func (m Manifest) validMyshka(channel Channel, now time.Time) error {
+	if channel != Stable && channel != Beta {
+		return errors.New("update: unknown Myshka channel")
+	}
+	if m.Schema != 1 || m.Distribution != MyshkaDistribution || m.Channel != channel.Label() {
+		return errors.New("update: wrong Myshka distribution, schema or channel")
+	}
+	if len(m.Version) > 96 || !myshkaVersion.MatchString(m.Version) || ((channel == Beta) != strings.Contains(m.Version, "-beta.")) {
+		return errors.New("update: version does not belong to the signed Myshka channel")
+	}
+	if _, _, ok := parseVersion(m.Version); !ok {
+		return errors.New("update: unrankable Myshka version")
+	}
+	if m.PublishedAt <= 0 || m.ExpiresAt <= m.PublishedAt || m.ExpiresAt-m.PublishedAt > int64(maxManifestLifetime/time.Second) {
+		return errors.New("update: invalid manifest lifetime")
+	}
+	if m.PublishedAt > now.Add(10*time.Minute).Unix() || m.ExpiresAt <= now.Unix() {
+		return errors.New("update: manifest expired or not yet published")
+	}
+	if m.flat() != (Binary{}) || len(m.Binaries) != 1 || len(m.Rootfs) != 1 || len(m.Assets) != 0 {
+		return errors.New("update: Myshka requires exactly one Dot 2 binary and rootfs")
+	}
+	for _, part := range []struct {
+		kind    string
+		files   map[string]Binary
+		maximum int64
+	}{{"binary", m.Binaries, 64 << 20}, {"rootfs", m.Rootfs, 512 << 20}} {
+		b, ok := part.files["arm-dot"]
+		if !ok {
+			return errors.New("update: release is not for Echo Dot 2 arm-dot")
+		}
+		if err := b.valid(m.Version, "arm-dot"); err != nil {
+			return err
+		}
+		if b.Size > part.maximum {
+			return fmt.Errorf("update: %s exceeds size limit", part.kind)
+		}
+		if err := myshkaAssetURL(b.URL, m.Version); err != nil {
+			return err
+		}
+	}
+	if m.ReleaseURL != myshkaRepository+"/releases/tag/"+m.Version {
+		return errors.New("update: wrong release page")
+	}
+	return nil
+}
+
+func myshkaAssetURL(raw, version string) error {
+	u, err := url.Parse(raw)
+	prefix := "/ha-homelab/ha-techo5-dot/releases/download/" + version + "/"
+	if err != nil || u.Scheme != "https" || u.Host != "github.com" || u.User != nil || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.RawPath != "" || !strings.HasPrefix(u.Path, prefix) || !assetName.MatchString(strings.TrimPrefix(u.Path, prefix)) {
+		return errors.New("update: asset is not an immutable HTTPS release in the Myshka repository")
+	}
+	return nil
+}
+func (m Manifest) proofChannel() Channel {
+	if m.proof == nil {
+		return Channel(-1)
+	}
+	return m.proof.channel
+}
+
+// ReadyForInstall rejects synthetic, changed, expired or cross-channel cached
+// manifests. Fetch retains the signed bytes so every install verifies the key
+// again; a valid JSON object alone never authorizes a root filesystem write.
+func (m Manifest) ReadyForInstall(channel Channel) error {
+	if !clockSet() {
+		return ErrClock
+	}
+	if m.proof == nil || m.proof.channel != channel {
+		return errors.New("update: no signed proof for this channel")
+	}
+	if err := verify(m.proof.body, m.proof.signature, releaseKey); err != nil {
+		return err
+	}
+	var signed Manifest
+	if err := json.Unmarshal(m.proof.body, &signed); err != nil {
+		return err
+	}
+	a, err := json.Marshal(m)
+	if err != nil {
+		return err
+	}
+	b, err := json.Marshal(signed)
+	if err != nil {
+		return err
+	}
+	if !bytes.Equal(a, b) {
+		return errors.New("update: manifest changed after signature verification")
+	}
+	if err := m.Valid(); err != nil {
+		return err
+	}
+	return m.validMyshka(channel, time.Now())
+}
