+package update
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func myshkaFixture(c Channel) Manifest {
+	version := "v1.0.44_myshka2"
+	if c == Beta {
+		version = "v1.0.44-beta.202_myshka2"
+	}
+	asset := func(name string) Binary {
+		return Binary{URL: myshkaRepository + "/releases/download/" + version + "/" + name, SHA256: strings.Repeat("a", 64), Size: 4096}
+	}
+	return Manifest{Schema: 1, Distribution: MyshkaDistribution, Channel: c.Label(), Version: version, PublishedAt: time.Now().Add(-time.Hour).Unix(), ExpiresAt: time.Now().Add(180 * 24 * time.Hour).Unix(), Binaries: map[string]Binary{"arm-dot": asset("echod-arm-dot")}, Rootfs: map[string]Binary{"arm-dot": asset("myshka-rootfs-arm-dot.tar.gz")}, ReleaseURL: myshkaRepository + "/releases/tag/" + version}
+}
+func signedMyshka(t *testing.T, c Channel) Manifest {
+	t.Helper()
+	seed, pub := testKey(t)
+	before := releaseKey
+	releaseKey = pub
+	t.Cleanup(func() { releaseKey = before })
+	m := myshkaFixture(c)
+	body, err := json.Marshal(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	signature, err := Sign(body, seed)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m.proof = &releaseProof{body: body, signature: []byte(signature), channel: c}
+	return m
+}
+func TestMyshkaFixedChannelsAndKey(t *testing.T) {
+	if Stable.URL() != myshkaRepository+"/releases/download/myshka-stable/manifest.json" || Beta.URL() != myshkaRepository+"/releases/download/myshka-beta/manifest.json" {
+		t.Fatal("channel escaped own repository")
+	}
+	if Channel(-1).URL() != "" || Channel(3).URL() != "" {
+		t.Fatal("unknown channel accepted")
+	}
+	if Beta.Label() != "beta" || len(Channels()) != 2 {
+		t.Fatal("wrong channel selection")
+	}
+	raw, err := base64.StdEncoding.DecodeString(releaseKey)
+	if err != nil || len(raw) != 32 {
+		t.Fatal("invalid trust anchor")
+	}
+	if releaseKey != "VE1OZ3bqYzfSexvgIBbi6lGMkZW1VV22jnTTbogJBNw=" {
+		t.Fatal("unexpected production trust anchor")
+	}
+}
+func TestMyshkaManifestScope(t *testing.T) {
+	for _, c := range []Channel{Stable, Beta} {
+		if err := myshkaFixture(c).validMyshka(c, time.Now()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cases := map[string]func(*Manifest){
+		"distribution": func(m *Manifest) { m.Distribution = "upstream" }, "schema": func(m *Manifest) { m.Schema = 2 }, "cross-channel": func(m *Manifest) { m.Channel = "stable" },
+		"stock-version": func(m *Manifest) { m.Version = "v1.0.44" }, "wrong-stage": func(m *Manifest) { m.Version = "v1.0.44_myshka2" }, "expired": func(m *Manifest) { m.ExpiresAt = time.Now().Add(-time.Minute).Unix() },
+		"future": func(m *Manifest) { m.PublishedAt = time.Now().Add(time.Hour).Unix() }, "long-lived": func(m *Manifest) { m.ExpiresAt = m.PublishedAt + int64(367*24*time.Hour/time.Second) },
+		"no-rootfs": func(m *Manifest) { m.Rootfs = nil }, "wrong-board": func(m *Manifest) { m.Rootfs["arm-donut"] = m.Rootfs["arm-dot"]; delete(m.Rootfs, "arm-dot") },
+		"extra-board": func(m *Manifest) { m.Binaries["arm"] = m.Binaries["arm-dot"] }, "asset-executable": func(m *Manifest) { m.Assets = map[string]Binary{"script": m.Binaries["arm-dot"]} },
+		"missing-hash": func(m *Manifest) { b := m.Rootfs["arm-dot"]; b.SHA256 = ""; m.Rootfs["arm-dot"] = b }, "oversize": func(m *Manifest) { b := m.Rootfs["arm-dot"]; b.Size = 513 << 20; m.Rootfs["arm-dot"] = b },
+		"wrong-release": func(m *Manifest) { m.ReleaseURL = "https://github.com/HuskerMinion/techo5-dot/releases" },
+	}
+	for name, mutate := range cases {
+		t.Run(name, func(t *testing.T) {
+			m := myshkaFixture(Beta)
+			mutate(&m)
+			if err := m.validMyshka(Beta, time.Now()); err == nil {
+				t.Fatal("unsafe manifest accepted")
+			}
+		})
+	}
+}
+func TestMyshkaRejectsAssetURLSubstitution(t *testing.T) {
+	m := myshkaFixture(Beta)
+	good := m.Rootfs["arm-dot"].URL
+	for _, bad := range []string{strings.Replace(good, "https:", "http:", 1), strings.Replace(good, "ha-homelab", "other", 1), strings.Replace(good, m.Version, "latest", 1), good + "?token=x", good + "#x", strings.Replace(good, "github.com", "user@github.com", 1), strings.Replace(good, "github.com", "github.com:443", 1), strings.Replace(good, "myshka-rootfs-arm-dot.tar.gz", "%2e%2e/file", 1), good + "/../other"} {
+		if err := myshkaAssetURL(bad, m.Version); err == nil {
+			t.Errorf("accepted %s", bad)
+		}
+	}
+}
+func TestMyshkaInstallRequiresUnmodifiedSignature(t *testing.T) {
+	m := signedMyshka(t, Beta)
+	if err := m.ReadyForInstall(Beta); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.ReadyForInstall(Stable); err == nil {
+		t.Fatal("cross-channel proof accepted")
+	}
+	m.Notes = "changed"
+	if err := m.ReadyForInstall(Beta); err == nil {
+		t.Fatal("modified signed object accepted")
+	}
+	m = signedMyshka(t, Beta)
+	m.proof.signature[0] ^= 1
+	if err := m.ReadyForInstall(Beta); err == nil {
+		t.Fatal("bad signature accepted")
+	}
+	if err := myshkaFixture(Beta).ReadyForInstall(Beta); err == nil {
+		t.Fatal("unsigned object accepted")
+	}
+}
