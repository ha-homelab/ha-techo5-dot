+func TestGuardedClaimDoesNotPreemptItself(t *testing.T) {
+	l, reason := activitygate.Device.Reserve(time.Now().Add(5*time.Second), func() string { return "" })
+	if l == nil {
+		t.Fatal(reason)
+	}
+	defer l.Release()
+	d := driver()
+	var ran atomic.Bool
+	c := d.ClaimGuarded(l, func(ctx context.Context, _ *Player) error { ran.Store(true); return ctx.Err() })
+	waitFor(t, c)
+	if !ran.Load() || c.Err() != nil || c.Stopped() || l.Context().Err() != nil {
+		t.Fatal("guard preempted itself", c.Err(), l.Reason())
+	}
+}
+func TestGuardedClaimPreemptionWaitsForOwnedCleanup(t *testing.T) {
+	l, reason := activitygate.Device.Reserve(time.Now().Add(5*time.Second), func() string { return "" })
+	if l == nil {
+		t.Fatal(reason)
+	}
+	d := driver()
+	started := make(chan struct{})
+	c := d.ClaimGuarded(l, func(ctx context.Context, _ *Player) error { close(started); <-ctx.Done(); return ctx.Err() })
+	<-started
+	go func() { <-c.Done(); l.Release() }()
+	var ran atomic.Bool
+	next := d.Claim("ordinary", func(context.Context, *Player) error { ran.Store(true); return nil })
+	waitFor(t, next)
+	if !ran.Load() || l.Reason() != "preempted" || !c.Finished() {
+		t.Fatal("owned cleanup not complete")
+	}
+}
+func TestPlaybackProofRejectsMissingOutput(t *testing.T) {
+	if _, err := New().PlaybackProof(); err == nil {
+		t.Fatal("missing device reported healthy")
+	}
+}
+func TestAnnouncementIdleIncludesAllLanesAndTail(t *testing.T) {
+	p := New()
+	if !p.IdleForAnnouncement() {
+		t.Fatal("new player busy")
