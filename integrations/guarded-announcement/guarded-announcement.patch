+func TestGuardedDuckKeepsMusicAndRestoresAfterOwnedDrain(t *testing.T) {
+	for _, end := range []string{"complete", "cancel", "error", "preempt"} {
+		t.Run(end, func(t *testing.T) {
+			config.Use(filepath.Join(t.TempDir(), "config.json"))
+			if err := config.Set().Media().DuckDB(-15); err != nil {
+				t.Fatal(err)
+			}
+			p := New()
+			d := NewDriver(p)
+			music := &guardedMusic{p: p}
+			a := d.Backgrounds()
+			a.Took(music)
+			p.bed = []int16{7, 7, 7, 7}
+			volume := p.Volume()
+			l, reason := activitygate.Device.Reserve(time.Now().Add(5*time.Second), func() string {
+				if !a.GuardedMusicReady(p) {
+					return "bad route"
+				}
+				return ""
+			})
+			if l == nil {
+				t.Fatal(reason)
+			}
+			defer l.Release()
+			started, finish := make(chan struct{}), make(chan struct{})
+			c := d.ClaimGuardedDuck(l, func(ctx context.Context, p *Player) error {
+				if !music.quiet() || music.held() || !music.forced.Load() {
+					t.Error("music was not ducked continuously")
+				}
+				if end != "complete" {
+					p.mu.Lock()
+					p.pending = []int16{3, 3}
+					p.mu.Unlock()
+				}
+				close(started)
+				if end == "cancel" || end == "preempt" {
+					<-ctx.Done()
+					return ctx.Err()
+				}
+				<-finish
+				if end == "error" {
+					return errors.New("failed after queue")
+				}
+				return nil
+			})
+			<-started
+			switch end {
+			case "cancel":
+				l.Cancel("requested")
+			case "preempt":
+				go func() { <-c.Done(); l.Release() }()
+				leave, ok := activitygate.Device.Enter()
+				if !ok {
+					t.Fatal("failed to preempt")
+				}
+				leave()
+			default:
+				close(finish)
+			}
+			if end == "cancel" || end == "error" {
+				time.Sleep(HardwareTail / 3)
+				if !music.quiet() {
+					t.Error("restored music before speech hardware tail")
+				}
+			}
+			waitFor(t, c)
+			if music.quiet() || music.held() {
+				t.Fatal("music gain/hold leaked")
+			}
+			if p.Queued() != 0 || len(p.bed) != 4 {
+				t.Fatal("owned drain touched music or left speech")
+			}
+			if p.Volume() != volume {
+				t.Fatal("changed user volume")
+			}
+		})
+	}
+}
