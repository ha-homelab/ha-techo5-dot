index 0000000..6239409
--- /dev/null
+++ b/echod/internal/lib/activitygate/gate.go
@@ -0,0 +1,87 @@
+// Package activitygate coordinates ordinary device activity with a one-way announcement.
+// It contains no device, network or audio operations and is independently race-tested.
+package activitygate
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type Gate struct {
+	mu     sync.RWMutex
+	active atomic.Pointer[Lease]
+}
+type Lease struct {
+	gate   *Gate
+	ctx    context.Context
+	cancel context.CancelFunc
+	done   chan struct{}
+	once   sync.Once
+	reason atomic.Pointer[string]
+}
+
+var Device Gate
+
+// Enter admits ordinary activity. It first cancels an announcement, then waits for
+// that exact owner's queue to drain. Failure is busy, never permission to overlap.
+func (g *Gate) Enter() (func(), bool) {
+	deadline := time.NewTimer(2 * time.Second)
+	defer deadline.Stop()
+	for {
+		if g.mu.TryRLock() {
+			return g.mu.RUnlock, true
+		}
+		l := g.active.Load()
+		if l == nil {
+			return nil, false
+		}
+		l.Cancel("preempted")
+		select {
+		case <-l.done:
+		case <-deadline.C:
+			return nil, false
+		}
+	}
+}
+
+// Reserve checks all state under the same admission barrier used by ordinary
+// activity. A rejected reservation never disturbs that activity.
+func (g *Gate) Reserve(until time.Time, idle func() string) (*Lease, string) {
+	if !g.mu.TryLock() {
+		return nil, "busy"
+	}
+	if reason := idle(); reason != "" {
+		g.mu.Unlock()
+		return nil, reason
+	}
+	ctx, cancel := context.WithDeadline(context.Background(), until)
+	l := &Lease{gate: g, ctx: ctx, cancel: cancel, done: make(chan struct{})}
+	g.active.Store(l)
+	return l, ""
+}
+func (l *Lease) Context() context.Context { return l.ctx }
+func (l *Lease) Done() <-chan struct{}    { return l.done }
+func (l *Lease) Valid() bool              { return l != nil && l.gate.active.Load() == l && l.ctx.Err() == nil }
+func (l *Lease) Cancel(reason string)     { l.reason.CompareAndSwap(nil, &reason); l.cancel() }
+func (l *Lease) Reason() string {
+	if p := l.reason.Load(); p != nil {
+		return *p
+	}
+	if l.ctx.Err() != nil {
+		return "deadline_expired"
+	}
+	return ""
+}
+func (l *Lease) Release() {
+	l.once.Do(func() { l.cancel(); l.gate.active.CompareAndSwap(l, nil); l.gate.mu.Unlock(); close(l.done) })
+}
+
+// Interrupt is safe under a configuration mutex: cancellation does not wait or
+// call the player. The owner's worker clears its own sound before releasing.
+func (g *Gate) Interrupt(reason string) {
+	if l := g.active.Load(); l != nil {
+		l.Cancel(reason)
+	}
+}
