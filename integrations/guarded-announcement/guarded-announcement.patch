+package voice
+
+import (
+	"github.com/HuskerMinion/techo5/echod/internal/lib/activitygate"
+	"github.com/HuskerMinion/techo5/echod/internal/lib/guardedannounce"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// A broken journal prevents a new submission, never access to the existing
+// manager's status/cancel path. No hardware, configuration or network is used.
+func TestGuardedManagerRemainsReachableAfterJournalFailure(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "jobs.json")
+	m, err := guardedannounce.Open(path, new(activitygate.Gate), func() string { return "" })
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Mkdir(path, 0700); err != nil {
+		t.Fatal(err)
+	}
+	id := "announce-0123456789abcdef0123456789abcdef-223"
+	m.Submit(id, "http://ha.invalid/file.wav", time.Now().Add(time.Minute).Unix(), func(*activitygate.Lease, func() error) error { t.Fatal("audio must not run"); return nil })
+	if m.Healthy() {
+		t.Fatal("failed persistence remained healthy")
+	}
+	v := &Voice{guarded: m}
+	v.guardedOnce.Do(func() {})
+	got, err := v.guardedManager()
+	if err != nil || got != m {
+		t.Fatal("cancel/status manager unavailable", err)
+	}
+	if got.Stop(id).Status != "unknown" {
+		t.Fatal("failed journal should report unknown")
+	}
+}
