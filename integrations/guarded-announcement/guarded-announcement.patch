+package guardedannounce
+
+import (
+	"encoding/json"
+	"errors"
+	"github.com/HuskerMinion/techo5/echod/internal/lib/activitygate"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+const id = "announce-0123456789abcdef0123456789abcdef-223"
+const other = "announce-abcdef0123456789abcdef0123456789-224"
+const media = "http://ha.invalid/file.wav"
+
+func manager(t *testing.T, idle func() string) *Manager {
+	t.Helper()
+	m, e := Open(filepath.Join(t.TempDir(), "jobs.json"), new(activitygate.Gate), idle)
+	if e != nil {
+		t.Fatal(e)
+	}
+	return m
+}
+func wait(t *testing.T, m *Manager, want string) {
+	t.Helper()
+	until := time.Now().Add(3 * time.Second)
+	for time.Now().Before(until) {
+		if m.Status(id).Status == want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal(m.Status(id))
+}
+func TestDurableReceiptBeforePlaybackAndDedup(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	expires := time.Now().Add(time.Minute).Unix()
+	var played atomic.Int32
+	done := make(chan struct{})
+	play := func(l *activitygate.Lease, mark func() error) error {
+		var records map[string]record
+		b, e := os.ReadFile(m.path)
+		if e != nil {
+			t.Error(e)
+		}
+		if e = json.Unmarshal(b, &records); e != nil {
+			t.Error(e)
+		}
+		if records[id].Status != "accepted" {
+			t.Error("not durable before playback")
+		}
+		played.Add(1)
+		if e = mark(); e != nil {
+			return e
+		}
+		<-done
+		return nil
+	}
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			r := m.Submit(id, media, expires, play)
+			if r.Status != "accepted" && r.Status != "playing" {
+				t.Error(r)
+			}
+		}()
+	}
+	wg.Wait()
+	wait(t, m, "playing")
+	if played.Load() != 1 {
+		t.Fatal(played.Load())
+	}
+	if m.Submit(id, media+"?changed", expires, play).Reason != "request_conflict" {
+		t.Fatal("conflicting request accepted")
+	}
+	close(done)
+	wait(t, m, "completed")
+	restored, e := Open(m.path, new(activitygate.Gate), func() string { return "" })
+	if e != nil {
+		t.Fatal(e)
+	}
+	if restored.Submit(id, media, expires, play).Status != "completed" || played.Load() != 1 {
+		t.Fatal("replayed completed request")
+	}
+}
+func TestIdlePoliciesNeverPlay(t *testing.T) {
+	for _, reason := range []string{"phone_busy", "assist_busy", "audio_busy", "do_not_disturb", "quiet_hours"} {
+		t.Run(reason, func(t *testing.T) {
+			m := manager(t, func() string { return reason })
+			r := m.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(*activitygate.Lease, func() error) error { t.Error("played busy"); return nil })
+			if r.Status != "skipped" || r.Reason != reason {
+				t.Fatal(r)
+			}
+		})
+	}
+}
+func TestOwnedStopAndOrdinaryPreemption(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	started := make(chan struct{})
+	drained := make(chan struct{})
+	m.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(l *activitygate.Lease, mark func() error) error {
+		if e := mark(); e != nil {
+			return e
+		}
+		close(started)
+		<-l.Context().Done()
+		close(drained)
+		return l.Context().Err()
+	})
+	<-started
+	if m.Stop(other).Status != "unknown" {
+		t.Fatal("unknown cancel")
+	}
+	if m.Status(id).Status != "playing" {
+		t.Fatal("canceled wrong owner")
+	}
+	leave, ok := m.gate.Enter()
+	if !ok {
+		t.Fatal("preemption failed")
+	}
+	leave()
+	select {
+	case <-drained:
+	default:
+		t.Fatal("entered before drain")
+	}
+	wait(t, m, "stopped")
+	if m.Status(id).Reason != "preempted" {
+		t.Fatal(m.Status(id))
+	}
+}
+func TestRequestedStopAndFailure(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	m.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(l *activitygate.Lease, mark func() error) error {
+		if e := mark(); e != nil {
+			return e
+		}
+		<-l.Context().Done()
+		return l.Context().Err()
+	})
+	wait(t, m, "playing")
+	r := m.Stop(id)
+	if r.Status != "stopped" && r.Status != "unknown" {
+		t.Fatal(r)
+	}
+	wait(t, m, "stopped")
+	if m.Status(id).Reason != "requested" {
+		t.Fatal(m.Status(id))
+	}
+	m2 := manager(t, func() string { return "" })
+	m2.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(*activitygate.Lease, func() error) error { return errors.New("failed fetch") })
+	wait(t, m2, "failed")
+}
+func TestRestartUnknownNeverReplay(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	exp := time.Now().Add(time.Minute).Unix()
+	m.records[id] = record{m.receipt(id, "playing", ""), fingerprint(media, exp), exp}
+	if e := m.save(); e != nil {
+		t.Fatal(e)
+	}
+	n, e := Open(m.path, new(activitygate.Gate), func() string { return "" })
+	if e != nil {
+		t.Fatal(e)
+	}
+	r := n.Submit(id, media, exp, func(*activitygate.Lease, func() error) error { t.Error("replayed"); return nil })
+	if r.Status != "unknown" || r.Reason != "process_restarted" {
+		t.Fatal(r)
+	}
+}
+func TestRejectCorruptJournalAndStorageFailure(t *testing.T) {
+	for _, b := range []string{"null", "[]", "{broken", `{"id":{"status":"completed"}}`} {
+		p := filepath.Join(t.TempDir(), "journal")
+		os.WriteFile(p, []byte(b), 0600)
+		if _, e := Open(p, new(activitygate.Gate), func() string { return "" }); e == nil {
+			t.Fatal(b)
+		}
+	}
+	m := manager(t, func() string { return "" })
+	os.Mkdir(m.path, 0700)
+	r := m.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(*activitygate.Lease, func() error) error { t.Error("played without durable journal"); return nil })
+	if r.Status != "unknown" || m.Status(id).Status != "unknown" {
+		t.Fatal(r, m.Status(id))
+	}
+}
+func TestExpiredAndInvalidRequests(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	play := func(*activitygate.Lease, func() error) error { t.Error("invalid playback"); return nil }
+	for _, ex := range []int64{time.Now().Unix() - 1, time.Now().Add(181 * time.Second).Unix()} {
+		if m.Submit(id, media, ex, play).Status != "failed" {
+			t.Fatal("bad deadline")
+		}
+	}
+	for _, u := range []string{"file:///tmp/a", "http://u:p@ha/a", "http://ha/a#b", ""} {
+		if m.Submit(id, u, time.Now().Add(time.Minute).Unix(), play).Status != "failed" {
+			t.Fatal(u)
+		}
+	}
+}
+
+func TestBlockedPersistenceDoesNotHoldAudioGate(t *testing.T) {
+	for _, blockWrite := range []int32{1, 2} {
+		t.Run(string(rune('0'+blockWrite)), func(t *testing.T) {
+			m := manager(t, func() string { return "" })
+			entered := make(chan struct{})
+			release := make(chan struct{})
+			var writes atomic.Int32
+			m.saveHook = func() {
+				if writes.Add(1) == blockWrite {
+					close(entered)
+					<-release
+				}
+			}
+			returned := make(chan Receipt, 1)
+			go func() {
+				returned <- m.Submit(id, media, time.Now().Add(time.Minute).Unix(), func(l *activitygate.Lease, mark func() error) error { return mark() })
+			}()
+			select {
+			case <-entered:
+			case <-time.After(3 * time.Second):
+				t.Fatal("persistence did not block")
+			}
+			leave, ok := m.gate.Enter()
+			if !ok {
+				t.Error("blocked filesystem held audio gate")
+			} else {
+				leave()
+			}
+			stopped := make(chan Receipt, 1)
+			go func() { stopped <- m.Stop(id) }()
+			select {
+			case <-stopped:
+			case <-time.After(time.Second):
+				t.Error("Stop blocked on filesystem mutex")
+			}
+			close(release)
+			select {
+			case <-returned:
+			case <-time.After(3 * time.Second):
+				t.Fatal("submit did not return")
+			}
+			wait(t, m, "completed")
+		})
+	}
+}
