+func TestHealthCheckDoesNotWaitForJournalLock(t *testing.T) {
+	m := manager(t, func() string { return "" })
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	done := make(chan bool, 1)
+	go func() { done <- m.Healthy() }()
+	select {
+	case healthy := <-done:
+		if !healthy {
+			t.Fatal("unexpected failed health")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("health blocked on journal lock")
+	}
+	m.broken.Store(true)
+	if m.Healthy() {
+		t.Fatal("broken health not visible")
+	}
+}
