@@ -0,0 +1,87 @@
+package activitygate
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestClaimCannotOverlapAdmission(t *testing.T) {
+	var g Gate
+	leave, ok := g.Enter()
+	if !ok {
+		t.Fatal("ordinary admission")
+	}
+	if l, _ := g.Reserve(time.Now().Add(time.Minute), func() string { return "" }); l != nil {
+		t.Fatal("overlap")
+	}
+	leave()
+	l, r := g.Reserve(time.Now().Add(time.Minute), func() string { return "" })
+	if l == nil {
+		t.Fatal(r)
+	}
+	drained := make(chan struct{})
+	go func() { <-l.Context().Done(); time.Sleep(20 * time.Millisecond); close(drained); l.Release() }()
+	next, ok := g.Enter()
+	if !ok {
+		t.Fatal("preemption did not release")
+	}
+	defer next()
+	select {
+	case <-drained:
+	default:
+		t.Fatal("ordinary activity entered before owner drained")
+	}
+	if l.Reason() != "preempted" {
+		t.Fatal(l.Reason())
+	}
+}
+func TestBusyPredicateAndDeadline(t *testing.T) {
+	var g Gate
+	if l, r := g.Reserve(time.Now().Add(time.Minute), func() string { return "dnd" }); l != nil || r != "dnd" {
+		t.Fatal(l, r)
+	}
+	l, _ := g.Reserve(time.Now().Add(10*time.Millisecond), func() string { return "" })
+	defer l.Release()
+	<-l.Context().Done()
+	if l.Valid() || l.Reason() != "deadline_expired" {
+		t.Fatal("deadline did not invalidate lease")
+	}
+}
+func TestConcurrentActivitiesAndReservations(t *testing.T) {
+	var g Gate
+	var readers atomic.Int32
+	var writer atomic.Bool
+	var wg sync.WaitGroup
+	for range 16 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for range 100 {
+				leave, ok := g.Enter()
+				if !ok {
+					continue
+				}
+				readers.Add(1)
+				if writer.Load() {
+					t.Error("reader with writer")
+				}
+				readers.Add(-1)
+				leave()
+			}
+		}()
+	}
+	for range 100 {
+		l, _ := g.Reserve(time.Now().Add(time.Minute), func() string { return "" })
+		if l != nil {
+			writer.Store(true)
+			if readers.Load() != 0 {
+				t.Error("writer with reader")
+			}
+			writer.Store(false)
+			l.Release()
+		}
+	}
+	wg.Wait()
+}
diff --git a/echod/internal/lib/guardedannounce/manager.go b/echod/internal/lib/guardedannounce/manager.go
new file mode 100644
index 0000000..8215aea
--- /dev/null
+++ b/echod/internal/lib/guardedannounce/manager.go
@@ -0,0 +1,355 @@
+// Package guardedannounce implements durable, bounded one-way announcement jobs.
+package guardedannounce
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/HuskerMinion/techo5/echod/internal/lib/activitygate"
+)
+
+const Protocol = "cisco-announcement-v1"
+const MaxDuration = 180 * time.Second
+const maxRecords = 512
+
+var requestPattern = regexp.MustCompile(`^announce-[0-9a-f]{32}-[0-9]{3}$`)
+
+type Receipt struct {
+	RequestID string `json:"request_id"`
+	Status    string `json:"status"`
+	Reason    string `json:"reason,omitempty"`
+	Protocol  string `json:"protocol"`
+	BootID    string `json:"boot_id"`
+}
+type record struct {
+	Receipt
+	Fingerprint string `json:"fingerprint"`
+	ExpiresAt   int64  `json:"expires_at"`
+}
+type Playback func(*activitygate.Lease, func() error) error
+type Manager struct {
+	mu         sync.Mutex
+	path, boot string
+	records    map[string]record
+	leases     sync.Map
+	gate       *activitygate.Gate
+	idle       func() string
+	broken     atomic.Bool
+	saveHook   func() // tests only; nil in production
+}
+
+func Open(path string, gate *activitygate.Gate, idle func() string) (*Manager, error) {
+	b := make([]byte, 16)
+	if _, err := rand.Read(b); err != nil {
+		return nil, err
+	}
+	m := &Manager{path: path, boot: hex.EncodeToString(b), records: map[string]record{}, gate: gate, idle: idle}
+	data, err := os.ReadFile(path)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	if err == nil {
+		if len(data) > 1024*1024 {
+			return nil, errors.New("announcement journal too large")
+		}
+		if err = json.Unmarshal(data, &m.records); err != nil {
+			return nil, err
+		}
+		if m.records == nil {
+			return nil, errors.New("null announcement journal")
+		}
+		if len(m.records) > maxRecords {
+			return nil, errors.New("announcement journal too many records")
+		}
+	}
+	changed := false
+	for id, r := range m.records {
+		_, hashErr := hex.DecodeString(r.Fingerprint)
+		_, bootErr := hex.DecodeString(r.BootID)
+		if !requestPattern.MatchString(id) || r.RequestID != id || r.Protocol != Protocol || len(r.Fingerprint) != 64 || hashErr != nil || len(r.BootID) != 32 || bootErr != nil || r.ExpiresAt <= 0 || !validStatus(r.Status) {
+			return nil, errors.New("invalid announcement journal record")
+		}
+		if r.Status == "accepted" || r.Status == "playing" {
+			r.Status = "unknown"
+			r.Reason = "process_restarted"
+			m.records[id] = r
+			changed = true
+		}
+	}
+	if changed {
+		if err = m.save(); err != nil {
+			return nil, err
+		}
+	}
+	return m, nil
+}
+func (m *Manager) BootID() string { return m.boot }
+func (m *Manager) receipt(id, status, reason string) Receipt {
+	return Receipt{id, status, reason, Protocol, m.boot}
+}
+func (m *Manager) ValidateID(id string) bool { return requestPattern.MatchString(id) }
+func fingerprint(media string, expires int64) string {
+	s := sha256.Sum256([]byte(fmt.Sprintf("%d\n%s", expires, media)))
+	return hex.EncodeToString(s[:])
+}
+func (m *Manager) Submit(id, media string, expires int64, play Playback) Receipt {
+	return m.submit(id, media, expires, fingerprint(media, expires), m.idle, play)
+}
+
+// SubmitDuck shares the durable ID namespace with Submit. Only its fingerprint
+// and admission policy differ; old skip fingerprints remain byte-for-byte valid.
+func (m *Manager) SubmitDuck(id, media string, expires int64, idle func() string, play Playback) Receipt {
+	sum := sha256.Sum256([]byte("duck_music\n" + fingerprint(media, expires)))
+	return m.submit(id, media, expires, hex.EncodeToString(sum[:]), idle, play)
+}
+
+func (m *Manager) submit(id, media string, expires int64, fp string, idle func() string, play Playback) Receipt {
+	m.mu.Lock()
+	if !requestPattern.MatchString(id) {
+		m.mu.Unlock()
+		return m.receipt(id, "failed", "invalid_request_id")
+	}
+	if r, ok := m.records[id]; ok {
+		m.mu.Unlock()
+		if r.Fingerprint != fp {
+			return m.receipt(id, "failed", "request_conflict")
+		}
+		r.BootID = m.boot
+		return r.Receipt
+	}
+	now := time.Now()
+	deadline := time.Unix(expires, 0)
+	if !deadline.After(now) || deadline.Sub(now) > MaxDuration {
+		m.mu.Unlock()
+		return m.receipt(id, "failed", "invalid_expiry")
+	}
+	u, err := url.Parse(media)
+	if err != nil || len(media) > 4096 || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" || u.User != nil || u.Fragment != "" {
+		m.mu.Unlock()
+		return m.receipt(id, "failed", "invalid_media_id")
+	}
+	if m.broken.Load() {
+		m.mu.Unlock()
+		return m.receipt(id, "unknown", "journal_unavailable")
+	}
+	for k, r := range m.records {
+		if r.ExpiresAt < now.Add(-24*time.Hour).Unix() {
+			delete(m.records, k)
+		}
+	}
+	if len(m.records) >= maxRecords {
+		m.mu.Unlock()
+		return m.receipt(id, "failed", "journal_full")
+	}
+	// Disk persistence precedes device reservation: stalled storage cannot hold audio.
+	r := record{m.receipt(id, "accepted", ""), fp, expires}
+	m.records[id] = r
+	if err = m.save(); err != nil {
+		m.broken.Store(true)
+		r.Status = "unknown"
+		r.Reason = "journal_unavailable"
+		m.records[id] = r
+		m.mu.Unlock()
+		return r.Receipt
+	}
+	if !deadline.After(time.Now()) {
+		r.Status = "failed"
+		r.Reason = "expired_before_admission"
+		m.records[id] = r
+		if err = m.save(); err != nil {
+			m.broken.Store(true)
+			r.Status = "unknown"
+			r.Reason = "journal_unavailable"
+			m.records[id] = r
+		}
+		m.mu.Unlock()
+		return r.Receipt
+	}
+	lease, reason := m.gate.Reserve(deadline, idle)
+	if lease == nil {
+		r.Status = "skipped"
+		r.Reason = reason
+		m.records[id] = r
+		if err = m.save(); err != nil {
+			m.broken.Store(true)
+			r.Status = "unknown"
+			r.Reason = "journal_unavailable"
+			m.records[id] = r
+		}
+	}
+
+	if lease != nil {
+		m.leases.Store(id, lease)
+	}
+	m.mu.Unlock()
+	if lease != nil {
+		go m.run(id, lease, play)
+	}
+	return r.Receipt
+}
+func (m *Manager) run(id string, lease *activitygate.Lease, play Playback) {
+	defer lease.Release()
+	defer func() {
+		lease.Release()
+		if recover() != nil {
+			m.update(id, "unknown", "playback_panicked", true)
+		}
+		m.leases.Delete(id)
+	}()
+	marked := false
+	mark := func() error {
+		if err := lease.Context().Err(); err != nil {
+			return err
+		}
+		r := m.update(id, "playing", "", false)
+		if r.Status != "playing" {
+			return errors.New(r.Reason)
+		}
+		if err := lease.Context().Err(); err != nil {
+			return err
+		}
+		marked = true
+		return nil
+	}
+	err := play(lease, mark)
+	status, reason := "completed", ""
+	if lease.Context().Err() != nil {
+		status, reason = "stopped", lease.Reason()
+	} else if err != nil || !marked {
+		status, reason = "failed", "playback_failed"
+	}
+	lease.Release() // owned audio and hardware tail have drained
+	m.update(id, status, reason, true)
+}
+func (m *Manager) update(id, status, reason string, persist bool) Receipt {
+	if persist {
+		m.mu.Lock()
+	} else if !m.lockBriefly() {
+		return m.receipt(id, "unknown", "journal_busy")
+	}
+	r := m.records[id]
+	r.Status = status
+	r.Reason = reason
+	r.BootID = m.boot
+	m.records[id] = r
+	if err := func() error {
+		if persist {
+			return m.save()
+		}
+		return nil
+	}(); err != nil {
+		m.broken.Store(true)
+		r.Status = "unknown"
+		r.Reason = "journal_unavailable"
+		m.records[id] = r
+	}
+	m.mu.Unlock()
+	return r.Receipt
+}
+func (m *Manager) Status(id string) Receipt {
+	if !m.mu.TryLock() {
+		return m.receipt(id, "unknown", "journal_busy")
+	}
+	defer m.mu.Unlock()
+	if r, ok := m.records[id]; ok {
+		r.BootID = m.boot
+		return r.Receipt
+	}
+	return m.receipt(id, "unknown", "request_not_found")
+}
+func (m *Manager) Stop(id string) Receipt {
+	var l *activitygate.Lease
+	if value, ok := m.leases.Load(id); ok {
+		l = value.(*activitygate.Lease)
+	}
+	if l != nil {
+		l.Cancel("requested")
+		select {
+		case <-l.Done():
+		case <-time.After(2 * time.Second):
+			return m.receipt(id, "unknown", "stop_pending")
+		}
+	}
+	r := m.Status(id)
+	if l != nil && (r.Status == "accepted" || r.Status == "playing") {
+		return m.receipt(id, "unknown", "stop_pending")
+	}
+	return r
+}
+func (m *Manager) save() error {
+	if m.saveHook != nil {
+		m.saveHook()
+	}
+	data, err := json.Marshal(m.records)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(m.path)
+	if err = os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(dir, ".announcements-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(data)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(name, m.path); err != nil {
+		return err
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+
+func validStatus(s string) bool {
+	switch s {
+	case "accepted", "playing", "completed", "skipped", "failed", "stopped", "unknown":
+		return true
+	}
+	return false
+}
+
+func (m *Manager) Healthy() bool { return !m.broken.Load() }
+
+// State publication inside the audio lease may wait for contention, never for an
+// unbounded filesystem operation owned by another submission.
+func (m *Manager) lockBriefly() bool {
+	until := time.Now().Add(100 * time.Millisecond)
+	for {
+		if m.mu.TryLock() {
+			return true
+		}
+		if !time.Now().Before(until) {
+			return false
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
