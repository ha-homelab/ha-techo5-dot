+func TestDuckPolicySharesDurableNamespaceAndAdmission(t *testing.T) {
+	m := manager(t, func() string { return "audio_busy" })
+	expires := time.Now().Add(time.Minute).Unix()
+	var count atomic.Int32
+	started, finish := make(chan struct{}), make(chan struct{})
+	play := func(l *activitygate.Lease, mark func() error) error {
+		count.Add(1)
+		if err := mark(); err != nil {
+			return err
+		}
+		close(started)
+		<-finish
+		return nil
+	}
+	idle := func() string { return "" }
+	if r := m.SubmitDuck(id, media, expires, idle, play); r.Status != "accepted" {
+		t.Fatal(r)
+	}
+	<-started
+	var wg sync.WaitGroup
+	for range 12 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			if r := m.SubmitDuck(id, media, expires, idle, play); r.Status != "playing" {
+				t.Error(r)
+			}
+		}()
+	}
+	wg.Wait()
+	if m.Submit(id, media, expires, play).Reason != "request_conflict" {
+		t.Fatal("duck ID accepted as skip")
+	}
+	close(finish)
+	wait(t, m, "completed")
+	if count.Load() != 1 {
+		t.Fatal("duplicate duck playback", count.Load())
+	}
+	reopened, err := Open(m.path, new(activitygate.Gate), idle)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reopened.SubmitDuck(id, media, expires, idle, play).Status != "completed" {
+		t.Fatal("duck receipt not durable")
+	}
+	if reopened.Submit(id, media, expires, play).Reason != "request_conflict" {
+		t.Fatal("policy conflict lost after restart")
+	}
+	if m.Submit(other, media, expires, play).Status != "skipped" {
+		t.Fatal("legacy skip no longer skips")
+	}
+	if m.SubmitDuck(other, media, expires, idle, play).Reason != "request_conflict" {
+		t.Fatal("skip ID accepted as duck")
+	}
+}
+func TestDuckPolicyRetainsBusyGuardsAndOwnedCancellation(t *testing.T) {
+	for _, reason := range []string{"phone_busy", "assist_busy", "ring_busy", "audio_busy", "unsupported_music_output", "do_not_disturb", "quiet_hours"} {
+		t.Run(reason, func(t *testing.T) {
+			m := manager(t, func() string { return "" })
+			r := m.SubmitDuck(id, media, time.Now().Add(time.Minute).Unix(), func() string { return reason }, func(*activitygate.Lease, func() error) error { t.Error("played while busy"); return nil })
+			if r.Status != "skipped" || r.Reason != reason {
+				t.Fatal(r)
+			}
+		})
+	}
+	m := manager(t, func() string { return "audio_busy" })
+	started := make(chan struct{})
+	m.SubmitDuck(id, media, time.Now().Add(time.Minute).Unix(), func() string { return "" }, func(l *activitygate.Lease, mark func() error) error {
+		if err := mark(); err != nil {
+			return err
+		}
+		close(started)
+		<-l.Context().Done()
+		return l.Context().Err()
+	})
+	<-started
+	m.Stop(other)
+	if m.Status(id).Status != "playing" {
+		t.Fatal("stopped wrong owner")
+	}
+	leave, ok := m.gate.Enter()
+	if !ok {
+		t.Fatal("ordinary activity blocked")
+	}
+	leave()
+	wait(t, m, "stopped")
+	if m.Status(id).Reason != "preempted" {
+		t.Fatal(m.Status(id))
+	}
+}
