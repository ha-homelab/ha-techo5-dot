+		t.Fatal(err)
+	}
+	p := speaker.New()
+	d := speaker.NewDriver(p)
+	a := d.Backgrounds()
+	s := NewStream(d, p, func() {}, func(string) {})
+	a.Took(s)
+	l, reason := activitygate.Device.Reserve(time.Now().Add(5*time.Second), func() string {
+		if !a.GuardedMusicReady(p) {
+			return "not ready"
+		}
+		return ""
+	})
+	if l == nil {
+		t.Fatal(reason)
+	}
+	defer l.Release()
+	started, finish := make(chan struct{}), make(chan struct{})
+	c := d.ClaimGuardedDuck(l, func(context.Context, *speaker.Player) error { close(started); <-finish; return nil })
+	<-started
+	s.mu.Lock()
+	holds, duckHeld := s.holds, s.duckHeld
+	s.mu.Unlock()
+	s.write.Lock()
+	target := s.target
+	s.write.Unlock()
+	if holds != 0 || duckHeld || target >= 1 {
+		t.Fatal("explicit duck paused music", holds, duckHeld, target)
+	}
+	// A later ordinary request coexists with the announcement token. Once the
+	// announcement releases its token, the normal pause preference takes effect.
+	a.Duck("ordinary-owner", true)
+	close(finish)
+	select {
+	case <-c.Done():
+	case <-time.After(2 * time.Second):
+		t.Fatal("claim did not finish")
+	}
+	s.mu.Lock()
+	holds, duckHeld = s.holds, s.duckHeld
+	s.mu.Unlock()
+	if holds != 1 || !duckHeld {
+		t.Fatal("ordinary pause ownership lost", holds, duckHeld)
+	}
+	a.Duck("ordinary-owner", false)
+	s.mu.Lock()
+	holds, duckHeld = s.holds, s.duckHeld
+	s.mu.Unlock()
+	if holds != 0 || duckHeld {
+		t.Fatal("pause did not restore", holds, duckHeld)
+	}
