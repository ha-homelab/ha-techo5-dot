+	"github.com/HuskerMinion/techo5/echod/internal/feature/phone"
+	"github.com/HuskerMinion/techo5/echod/internal/feature/ring"
+	"github.com/HuskerMinion/techo5/echod/internal/hardware/speaker"
+	"github.com/HuskerMinion/techo5/echod/internal/layout"
+	"github.com/HuskerMinion/techo5/echod/internal/lib/activitygate"
+	"github.com/HuskerMinion/techo5/echod/internal/lib/guardedannounce"
+	esphome "github.com/ygelfand/go-esphome-device"
+)
+
+// Once an owner exists, obtaining it never takes a journal lock or rereads disk.
+// A damaged journal blocks new work, but must not block stopping existing work.
+func (v *Voice) guardedManager() (*guardedannounce.Manager, error) {
+	v.guardedOnce.Do(func() {
+		if !encryptedAnnouncements() {
+			v.guardedErr = errors.New("guarded announcements require encrypted ESPHome")
+			return
+		}
+		v.guarded, v.guardedErr = guardedannounce.Open(filepath.Join(layout.StateDir, "guarded-announcements.json"), &activitygate.Device, v.guardedIdle)
+	})
+	return v.guarded, v.guardedErr
+}
+
+// guardedIdle is called under the exclusive admission barrier. Every competing
+// activity publishes its non-idle state while holding the shared barrier.
+func (v *Voice) guardedIdle() string     { return v.guardedIdlePolicy(false) }
+func (v *Voice) guardedDuckIdle() string { return v.guardedIdlePolicy(true) }
+func (v *Voice) guardedIdlePolicy(duck bool) string {
+	if ring.IsSounding() {
+		return "ring_busy"
+	}
+	if phone.Get().Busy() {
+		return "phone_busy"
+	}
+	if v.turn.Busy() || v.turn.guardWatch.Load() {
+		return "assist_busy"
+	}
+	if v.turn.sound.Busy() {
+		return "audio_busy"
+	}
+	backgrounds := v.turn.sound.Backgrounds()
+	if duck && backgrounds.Playing() != nil {
+		if !v.turn.speaker.ForegroundIdleForAnnouncement() {
+			return "audio_busy"
+		}
+		if !backgrounds.GuardedMusicReady(v.turn.speaker) {
+			return "unsupported_music_output"
+		}
+	} else {
+		if !v.turn.speaker.IdleForAnnouncement() || backgrounds.Playing() != nil {
+			return "audio_busy"
+		}
+		if v.turn.player.ExternalPlaying() {
+			return "media_busy"
+		}
+	}
+	if config.Get().Home.DoNotDisturb {
+		return "do_not_disturb"
+	}
+	if config.Quiet() {
+		return "quiet_hours"
+	}
+	if _, err := v.turn.speaker.PlaybackProof(); err != nil {
+		return "output_unavailable"
+	}
+	return ""
+}
+func encryptedAnnouncements() bool {
+	b, err := os.ReadFile(layout.KeyPath)
+	if err != nil {
+		return false
+	}
+	key, err := esphome.ParsePSK(strings.TrimSpace(string(b)))
+	return err == nil && !key.IsZero()
+}
+func (v *Voice) guardedActions() []*esphome.Action {
+	id := []esphome.Arg{{Name: "request_id", Type: esphome.ArgString}}
+	obtain := func() (*guardedannounce.Manager, error) {
+		return v.guardedManager()
+	}
+	submit := func(duck bool) func(esphome.Call) (any, error) {
+		return func(c esphome.Call) (any, error) {
+			m, err := obtain()
+			if err != nil {
+				return nil, err
+			}
+			if !m.Healthy() {
+				return nil, errors.New("announcement journal unavailable")
+			}
+			expires, err := strconv.ParseInt(c.String("expires_at"), 10, 64)
+			if err != nil {
+				return nil, errors.New("invalid expires_at")
+			}
+			url := c.String("media_id")
+			play := func(l *activitygate.Lease, mark func() error) error { return v.playGuarded(l, url, mark, duck) }
+			if duck {
+				return m.SubmitDuck(c.String("request_id"), url, expires, v.guardedDuckIdle, play), nil
+			}
+			return m.Submit(c.String("request_id"), url, expires, play), nil
+		}
+	}
+	args := []esphome.Arg{{Name: "request_id", Type: esphome.ArgString}, {Name: "media_id", Type: esphome.ArgString}, {Name: "expires_at", Type: esphome.ArgString}}
+	return []*esphome.Action{
+		{Name: "guarded_announcement_submit", Answers: true, Args: args, Run: submit(false)},
+		{Name: "guarded_announcement_submit_duck", Answers: true, Args: args, Run: submit(true)},
+		{Name: "guarded_announcement_status", Answers: true, Args: id, Run: func(c esphome.Call) (any, error) {
+			m, e := obtain()
+			if e != nil {
+				return nil, e
+			}
+			return m.Status(c.String("request_id")), nil
+		}},
+		{Name: "guarded_announcement_stop", Answers: true, Args: id, Run: func(c esphome.Call) (any, error) {
+			m, e := obtain()
+			if e != nil {
+				return nil, e
+			}
+			return m.Stop(c.String("request_id")), nil
+		}},
+		{Name: "guarded_announcement_capabilities", Answers: true, Args: id, Run: func(c esphome.Call) (any, error) {
+			m, e := obtain()
+			if e != nil {
+				return nil, e
+			}
+			if !m.Healthy() {
+				return nil, errors.New("announcement journal unavailable")
+			}
+			return map[string]any{"request_id": c.String("request_id"), "protocol": guardedannounce.Protocol, "boot_id": m.BootID(), "atomic_idle_guard": true, "dedup": true, "owned_cancel": true, "honest_completion": true, "deadline_enforced": true, "preannounce": false, "start_conversation": false, "busy_policy": "skip", "duck_music": true, "busy_policies": []string{"skip", "duck_music"}, "max_duration_seconds": 180}, nil
+		}},
+	}
+}
+
+// playGuarded owns the exclusive gate until it returns, including cancellation
+// drain. It never calls phone.Say, cancels an Assist pipeline, or opens a mic.
+func (v *Voice) playGuarded(l *activitygate.Lease, url string, mark func() error, duck bool) error {
+	monitorDone := make(chan struct{})
+	defer close(monitorDone)
+	go func() {
+		t := time.NewTicker(100 * time.Millisecond)
+		defer t.Stop()
+		for {
+			select {
+			case <-monitorDone:
+				return
+			case <-l.Context().Done():
+				return
+			case <-t.C:
+				if config.Get().Home.DoNotDisturb || config.Quiet() {
+					l.Cancel("silence_policy_changed")
+					return
+				}
+			}
+		}
+	}()
+	samples, err := media.Fetch(l.Context(), url)
+	if err != nil {
+		return err
+	}
+	if len(samples) == 0 || len(samples) > 120*speaker.VoiceRate {
+		return errors.New("announcement audio duration outside 0..120 seconds")
+	}
+	duration := time.Duration(len(samples))*time.Second/speaker.VoiceRate + time.Second
+	if until, ok := l.Context().Deadline(); !ok || time.Until(until) < duration {
+		return errors.New("announcement cannot finish before expiry")
+	}
+	if config.Get().Home.DoNotDisturb || config.Quiet() {
+		return errors.New("silence policy active")
+	}
+	proof, err := v.turn.speaker.PlaybackProof()
+	if err != nil {
+		return err
+	}
+	claim := v.turn.sound.ClaimGuarded
+	if duck {
+		claim = v.turn.sound.ClaimGuardedDuck
+	}
+	c := claim(l, func(ctx context.Context, p *speaker.Player) error {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if err := mark(); err != nil {
+			return err
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		p.PlayVoice(media.ForSpeaker(media.Normalize(samples), nil))
+		p.PlayVoice(make([]int16, speaker.VoiceRate*media.Tail/1000))
+		return p.WaitForeground(ctx, proof)
+	})
+	<-c.Done()
+	if c.Err() != nil {
+		return c.Err()
+	}
+	if c.Stopped() || l.Context().Err() != nil {
+		return fmt.Errorf("announcement stopped")
+	}
+	return v.turn.speaker.VerifyPlayback(proof)
+}
