+// PlaybackProof identifies one uninterrupted local output generation. It proves
+// software drain, not acoustic quality or that a person heard the message.
+type PlaybackProof struct {
+	Epoch, Dropped, Underruns, Written  uint64
+	ForegroundQueued, ForegroundWritten uint64
+}
+
+func (p *Player) PlaybackProof() (PlaybackProof, error) {
+	pb, _ := p.device()
+	if pb == nil || !p.playing.Load() || p.sink.Load() != nil {
+		return PlaybackProof{}, fmt.Errorf("local output unavailable")
+	}
+	return PlaybackProof{
+		Epoch: p.outputEpoch.Load(), Dropped: p.deaf.Load(), Underruns: p.underruns.Load(), Written: p.written.Load(),
+		ForegroundQueued: p.foregroundQueued.Load(), ForegroundWritten: p.foregroundWritten.Load(),
+	}, nil
+}
+
+// WaitForeground keeps a guarded duck active until every submitted foreground
+// frame has reached the local device. Background music never satisfies this wait.
+func (p *Player) WaitForeground(ctx context.Context, before PlaybackProof) error {
+	t := time.NewTicker(10 * time.Millisecond)
+	defer t.Stop()
+	for {
+		after, err := p.PlaybackProof()
+		if err != nil {
+			return err
+		}
+		if after.Epoch != before.Epoch || after.Dropped != before.Dropped || after.Underruns != before.Underruns {
+			return fmt.Errorf("output changed during announcement")
+		}
+		queued := after.ForegroundQueued - before.ForegroundQueued
+		if queued > 0 && after.ForegroundWritten-before.ForegroundWritten == queued && p.Queued() == 0 {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-t.C:
+		}
+	}
+}
+
+func (p *Player) VerifyPlayback(before PlaybackProof) error {
+	after, err := p.PlaybackProof()
+	if err != nil {
+		return err
+	}
+	return verifyPlayback(before, after, p.Queued())
+}
+
+// Only foreground samples count as announcement progress. Music and silence can
+// keep the card writing forever; neither proves that the announcement was played.
+func verifyPlayback(before, after PlaybackProof, pending int) error {
+	queued := after.ForegroundQueued - before.ForegroundQueued
+	written := after.ForegroundWritten - before.ForegroundWritten
+	if queued == 0 || written != queued || after.Epoch != before.Epoch || after.Dropped != before.Dropped || after.Underruns != before.Underruns || after.Written <= before.Written || pending != 0 {
+		return fmt.Errorf("output did not drain uninterrupted")
+	}
+	return nil
+}
+
+// IdleForAnnouncement includes all output lanes and the tail already handed to
+// hardware. A media Source remains busy even when its next buffer is silence.
+func (p *Player) IdleForAnnouncement() bool {
+	p.mu.Lock()
+	busy := len(p.pending)+len(p.bed)+len(p.under)+len(p.bell) > 0
+	recent := time.Since(time.Unix(0, p.lastAudibleNano.Load())) < HardwareTail
+	p.mu.Unlock()
+	p.srcMu.Lock()
+	hasSource := p.src != nil
+	p.srcMu.Unlock()
+	return !busy && !recent && !hasSource
+}
+
+// ForegroundIdleForAnnouncement allows music to continue but excludes call,
+// alarm and previous speech lanes, including the tail already sent to hardware.
+func (p *Player) ForegroundIdleForAnnouncement() bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return len(p.pending)+len(p.under)+len(p.bell) == 0 &&
+		time.Since(time.Unix(0, p.lastForegroundNano.Load())) >= HardwareTail
+}
+
+// MusicSourceIs verifies the currently attached renderer. A bed producer must
+// have no Source; a Source producer must not have unrelated queued bed audio.
+func (p *Player) MusicSourceIs(want Source) bool {
+	p.srcMu.Lock()
+	match := p.src == want
+	p.srcMu.Unlock()
+	if !match {
+		return false
+	}
+	if want != nil {
+		p.mu.Lock()
+		empty := len(p.bed) == 0
+		p.mu.Unlock()
+		return empty
+	}
+	return true
+}
+func (b *Bed) BelongsTo(p *Player) bool { return b != nil && b.p == p }
