+func TestGuardedMusicRequiresOwnReadyLocalSource(t *testing.T) {
+	p := speaker.New()
+	o := newOut(p)
+	p.Attach(o)
+	if o.OwnsMusicOutput(p) {
+		t.Fatal("unready source accepted")
+	}
+	o.ready = true
+	if !o.OwnsMusicOutput(p) {
+		t.Fatal("own ready source rejected")
+	}
+	o.held = true
+	if o.OwnsMusicOutput(p) {
+		t.Fatal("suspended source accepted")
+	}
+	o.held = false
+	if o.OwnsMusicOutput(speaker.New()) {
+		t.Fatal("unrelated player accepted")
+	}
+	p.Attach(newOut(p))
+	if o.OwnsMusicOutput(p) {
+		t.Fatal("unrelated source accepted")
+	}
+	p.Attach(nil)
+	if o.OwnsMusicOutput(p) {
+		t.Fatal("missing source accepted")
+	}
+	o.DuckMusic(-15)
+	if o.gain <= 0 || o.gain >= 1 || o.held {
+		t.Fatal("duck should attenuate without pausing", o.gain, o.held)
+	}
+	o.DuckMusic(0)
+	if o.gain != 1 || o.held {
+		t.Fatal("duck did not restore", o.gain, o.held)
+	}
+}
